{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "types": ["bun"],

    "noEmit": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": ["src/**/*.ts"],

  "exclude": ["node_modules"]
}